# Copy to .env.local (ignored by git) and fill in.

# Clerk publishable key: the same instance the web app uses
# (NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY in my-money-v2). Safe to ship in the app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Adapty public SDK key (Adapty → App settings → General → Public SDK key).
# With it set, store builds sell plans through the App Store / Google Play;
# without it (and always in Expo Go) the app sells through the web checkout.
# EXPO_PUBLIC_ADAPTY_PUBLIC_KEY=

# Base URL of the web app, which serves the API under /api/mobile.
# Leave unset in development to use port 3000 of the machine running Metro.
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Development only: skip sign-in and use the web app's seeded sample user.
# The web app must be started with MOBILE_API_SAMPLE_USER=1 as well.
# EXPO_PUBLIC_DEV_SAMPLE_USER=1
