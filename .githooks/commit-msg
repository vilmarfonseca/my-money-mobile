#!/bin/sh
# Enforce Conventional Commits on the message's first line:
#   <type>(optional scope)!: subject
# e.g. "feat: add income calendar", "fix(accounts): apply deposits to balance"
first_line=$(head -n 1 "$1")

# Merges, reverts generated by git, and autosquash commits pass through.
case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|chore|docs|style|refactor|perf|test|build|ci|revert)(\([a-zA-Z0-9/_.-]+\))?!?: .+'
if echo "$first_line" | grep -Eq "$pattern"; then
  exit 0
fi

echo "Commit message must follow Conventional Commits:"
echo "  <type>[(scope)][!]: <subject>"
echo "  types: feat fix chore docs style refactor perf test build ci revert"
echo ""
echo "Got: \"$first_line\""
exit 1
